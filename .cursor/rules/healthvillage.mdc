### 3. API 호출 패턴
```dart
// Repository 패턴 사용
abstract class HospitalRepository {
  Future<List<Hospital>> getNearbyHospitals({
    required double latitude,
    required double longitude,
    int radius = 1000,
  });
}

// HIRA API (건강보험심사평가원) 호출 패턴
class HospitalApiService {
  static const String baseUrl = 'http://apis.data.go.kr/B551182/hospInfoServicev2';
  
  Future<List<HospitalModel>> getHospitalList({
    String? sidoCd,
    String? sgguCd,
    String? clCd,  // 병원 종별코드
    String? yadmNm, // 병원명
  }) async {
    final queryParameters = {
      'ServiceKey': dotenv.env['HIRA_API_KEY'],
      'pageNo': pageNo.toString(),
      'numOfRows': numOfRows.toString(),
      if (sidoCd != null) 'sidoCd': sidoCd,
      if (clCd != null) 'clCd': clCd,
    };
    
    final response = await _dio.get('/getHospBasisList', queryParameters: queryParameters);
    
    // XML 파싱
    final document = xml.XmlDocument.parse(response.data);
    final items = document.findAllElements('item');
    return items.map((item) => HospitalModel.fromXml(item)).toList();
  }
}

// Error Handling
try {
  final result = await repository.getNearbyHospitals();
  return result;
} on DioError catch (e) {
  throw ServerException(e.message);
} catch (e) {
  throw UnknownException();
}
```

### 4. 상태 관리
```dart
// Riverpod StateNotifier 사용
class HospitalListNotifier extends StateNotifier<AsyncValue<List<Hospital>>> {
  HospitalListNotifier() : super(const AsyncValue.loading());
  
  Future<void> loadHospitals() async {
    state = const AsyncValue.loading();
    try {
      final hospitals = await _repository.getNearbyHospitals();
      state = AsyncValue.data(hospitals);
    } catch (e, st) {
      state = AsyncValue.error(e, st);
    }
  }
}
```

